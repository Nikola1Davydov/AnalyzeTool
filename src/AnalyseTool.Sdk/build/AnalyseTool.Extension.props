<Project>

  <!--
    Shared MSBuild settings for AnalyseTool.Sdk and every C# extension that targets it.
    Import near the top of an extension .csproj:

        <Import Project="..\..\AnalyseTool.Sdk\build\AnalyseTool.Extension.props" />

    CRITICAL: Revit API (and, in extension projects, the SDK itself) are referenced compile-only
    (PrivateAssets=all + ExcludeAssets=runtime / <Private>false</Private>) so the build output does
    NOT carry duplicate copies. The host owns those assemblies; the extension's AssemblyLoadContext
    shares the host's, which is what keeps type identity intact (IRevitTask, UIApplication, JToken).
  -->

    <PropertyGroup>
        <Configurations>
            Debug R25;
            Debug R26;
            Debug R27;
            Release R25;
            Release R26;
            Release R27;
        </Configurations>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>
    
    <PropertyGroup>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('R27'))">
        <RevitVersion>2027</RevitVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

  <!-- The configuration IS the Revit-year selector. A configuration naming no year at all — the plain
       `Debug` default of `dotnet build -t:PackExtension`, which is how the publishing pipeline is
       documented — falls back to the lowest supported year so the outer evaluation has a TargetFramework;
       PackExtension then builds every year in child processes with an explicit `Release R*`.
       A configuration naming an UNKNOWN year ("Release R28") is a typo, not a default: it leaves
       RevitVersion empty here and the .NET SDK fails loudly on the missing TargetFramework. -->
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <_ATConfiguredYear>$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)', 'R[0-9]+').Value)</_ATConfiguredYear>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '' and '$(_ATConfiguredYear)' == ''">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- The Revit API version floats with the configuration ($(RevitVersion).*), so it cannot live in a
       central Directory.Packages.props. Central Package Management ON (the AnalyseTool repo) needs
       VersionOverride — plain Version is error NU1008 — and CPM OFF needs plain Version, since
       VersionOverride would be ignored with NU1009. The conditional metadata picks the right one.

       SKIPPED when this file arrives from the NuGet package. A package consumer MUST declare these
       two references in their own csproj: package-shipped props are invisible to the FIRST restore
       (the package is not on disk yet), so nothing else can put them there. On every later restore
       the package IS present, this file is imported, and its copies collide with the author's —
       which is the NU1504 duplicate-PackageReference warning every consumer was getting, six times
       per build, caused by the very setup our own §4.1 tells them to write. -->
  <ItemGroup Condition="'$(_AnalyseToolSdkFromPackage)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(RevitVersion).*</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(RevitVersion).*</VersionOverride>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(RevitVersion).*</Version>
      <VersionOverride Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(RevitVersion).*</VersionOverride>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
