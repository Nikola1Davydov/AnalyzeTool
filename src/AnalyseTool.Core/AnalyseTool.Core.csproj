<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\AnalyseTool.Sdk\build\AnalyseTool.Extension.props" />

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Version attributes come from AssemblyInfo.cs (ToolData.PLUGIN_VERSION), like App/Launcher. -->
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <!-- Roslyn: compiles user/AI C# scripts into extensions at runtime (RoslynScriptCompiler). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <!-- CommandDispatcher generates JSON Schemas for command inputs via AIJsonUtilities. -->
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Newtonsoft.Json" />
        <!-- Log calls only; the sinks are configured by the host (AppLog). -->
        <PackageReference Include="Serilog" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AnalyseTool.Sdk\AnalyseTool.Sdk.csproj" />
    </ItemGroup>

    <!-- What CreateExtensionTemplate writes into a new extension folder. Embedded rather than copied
         next to the DLL: Core ships as a single assembly into the add-in folder, and a loose file is
         one more thing packaging or an installer can drop. LogicalName is explicit so a folder rename
         cannot silently change a resource name the code looks up by string.

         LLM.md is the REPOSITORY's own src/LLM.md, not a copy of it — the generated author guide and
         the paste-into-AI document are now the same file by construction. -->
    <ItemGroup>
        <!-- Hello.cs keeps the .cs extension so an editor treats it as C#, which is the point of
             having it as a file at all — so it MUST be removed from the default **\*.cs compile glob,
             or Core tries to compile the template as part of itself. Placeholders are __Token__
             rather than $token$ precisely so the template still reads as valid C#. -->
        <Compile Remove="Features\Extensions\Templates\**\*.cs" />

        <EmbeddedResource Include="Features\Extensions\Templates\Template.csproj.xml"
                          LogicalName="AnalyseTool.Core.Templates.Extension.csproj.xml" />
        <EmbeddedResource Include="Features\Extensions\Templates\Hello.cs"
                          LogicalName="AnalyseTool.Core.Templates.Hello.cs" />
        <EmbeddedResource Include="..\LLM.md"
                          LogicalName="AnalyseTool.Core.Templates.LLM.md" />
    </ItemGroup>

    <!-- PathProvider needs ToolData.PLUGIN_NAME. -->
    <Import Project="..\SharedData\SharedData.projitems" Label="Shared" />

    <!-- InternalsVisibleTo lives in AssemblyInfo.cs: GenerateAssemblyInfo=False (version attributes
         come from ToolData) would silently drop csproj-level IVT items. -->

</Project>
