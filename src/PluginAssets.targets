<Project>

  <!--
    Shared plugin-folder assets, imported by BOTH plugin-shaped outputs:
      - AnalyseTool.App      (the host assembly's own bin\<cfg>\AnalyseTool folder)
      - AnalyseTool.Launcher (the deployable bundle that CopyToRevitFolder ships to Addins)
    One definition instead of two drifting copies (they had already diverged once).
    Paths are anchored to THIS file's folder (src\), so no SolutionDir property is required.
  -->

  <!-- The out-of-process MCP stdio server ships in a "mcp" subfolder; the Settings page points
       the AI client's config at <plugin>\mcp\AnalyseTool.Mcp.exe.

       PUBLISHED, not built: self-contained, single-file, win-x64. The exe is started by the AI
       client, not by Revit, so it cannot borrow Revit's runtime — a framework-dependent net8.0 exe
       relied on a .NET 8 runtime happening to be installed, which Revit 2025/2026 guarantee and a
       Revit 2027 (net10) machine does not. Self-contained costs ~70 MB in mcp\ and buys an exe that
       runs on any Windows x64 with nothing installed. The switches are passed HERE rather than set
       in the csproj so the ProjectReferences on the exe (build order only) keep seeing an ordinary
       project — NETSDK1150 refuses a self-contained referenced project. -->
  <PropertyGroup>
    <ATMcpPublishDir>$(MSBuildThisFileDirectory)AnalyseTool.Mcp\bin\$(Configuration)\publish\</ATMcpPublishDir>
  </PropertyGroup>
  <Target Name="ATBuildAndCopyMcpServer" AfterTargets="Build" BeforeTargets="CopyToRevitFolder">
    <Message Text="Publishing AnalyseTool.Mcp (self-contained, single file) into the plugin folder..." Importance="high" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)AnalyseTool.Mcp\AnalyseTool.Mcp.csproj"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishDir=$(ATMcpPublishDir)"
             Targets="Publish" />
    <ItemGroup>
      <ATMcpFiles Include="$(ATMcpPublishDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ATMcpFiles)" DestinationFolder="$(OutputPath)\mcp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The compiled web frontend (clientapp/dist) is served from the plugin folder in Release. -->
  <Target Name="ATCopyClientAppDist" AfterTargets="Build" BeforeTargets="CopyToRevitFolder">
    <Message Text="Copying clientapp/dist into the plugin folder..." Importance="high" />
    <ItemGroup>
      <ATDistFiles Include="$(MSBuildThisFileDirectory)clientapp\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ATDistFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
