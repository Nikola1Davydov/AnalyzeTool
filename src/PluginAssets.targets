<Project>

  <!--
    Shared plugin-folder assets, imported by BOTH plugin-shaped outputs:
      - AnalyseTool.App      (the host assembly's own bin\<cfg>\AnalyseTool folder)
      - AnalyseTool.Launcher (the deployable bundle that CopyToRevitFolder ships to Addins)
    One definition instead of two drifting copies (they had already diverged once).
    Paths are anchored to THIS file's folder (src\), so no SolutionDir property is required.
  -->

  <!-- The out-of-process MCP stdio server ships in a "mcp" subfolder; the Settings page points
       the AI client's config at <plugin>\mcp\AnalyseTool.Mcp.exe.

       PUBLISHED, not built: framework-dependent, single-file, win-x64. The exe is started by the AI
       client, not by Revit, so it cannot borrow Revit's process — but it CAN use the runtime Revit
       installed on the machine: Revit 2025/2026 bring .NET 8, Revit 2027 brings .NET 10, and the
       exe declares RollForward=LatestMajor so a net8.0 build starts on either. 1.5.1 shipped it
       self-contained (~36 MB, runs with nothing installed); 1.5.2 goes back to a few MB because the
       only machines that matter have Revit, and Revit brings a runtime. The switches are passed
       HERE rather than set in the csproj so the ProjectReferences on the exe (build order only)
       keep seeing an ordinary project. -->
  <PropertyGroup>
    <ATMcpPublishDir>$(MSBuildThisFileDirectory)AnalyseTool.Mcp\bin\$(Configuration)\publish\</ATMcpPublishDir>
  </PropertyGroup>
  <Target Name="ATBuildAndCopyMcpServer" AfterTargets="Build" BeforeTargets="CopyToRevitFolder">
    <Message Text="Publishing AnalyseTool.Mcp (framework-dependent, single file) into the plugin folder..." Importance="high" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)AnalyseTool.Mcp\AnalyseTool.Mcp.csproj"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$(ATMcpPublishDir)"
             Targets="Publish" />
    <ItemGroup>
      <ATMcpFiles Include="$(ATMcpPublishDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ATMcpFiles)" DestinationFolder="$(OutputPath)\mcp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The command line into Core (AnalyseTool.Cli) ships INSIDE the plugin folder, next to
       AnalyseTool.Core.dll, so it resolves Core and every shared dependency from there: only the exe,
       its dll, deps.json and runtimeconfig.json are copied. Built with the same configuration, so the
       TFM matches the folder's. -->
  <PropertyGroup>
    <ATCliProject>$(MSBuildThisFileDirectory)AnalyseTool.Cli\AnalyseTool.Cli.csproj</ATCliProject>
  </PropertyGroup>
  <Target Name="ATBuildAndCopyCli" AfterTargets="Build" BeforeTargets="CopyToRevitFolder">
    <Message Text="Building AnalyseTool.Cli into the plugin folder..." Importance="high" />
    <MSBuild Projects="$(ATCliProject)" Properties="Configuration=$(Configuration)" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="ATCliAssembly" />
    </MSBuild>
    <ItemGroup>
      <ATCliFiles Include="@(ATCliAssembly->'%(RootDir)%(Directory)AnalyseTool.Cli.exe')" />
      <ATCliFiles Include="@(ATCliAssembly->'%(RootDir)%(Directory)AnalyseTool.Cli.dll')" />
      <ATCliFiles Include="@(ATCliAssembly->'%(RootDir)%(Directory)AnalyseTool.Cli.deps.json')" />
      <ATCliFiles Include="@(ATCliAssembly->'%(RootDir)%(Directory)AnalyseTool.Cli.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(ATCliFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>

  <!-- The compiled web frontend (clientapp/dist) is served from the plugin folder in Release. -->
  <Target Name="ATCopyClientAppDist" AfterTargets="Build" BeforeTargets="CopyToRevitFolder">
    <Message Text="Copying clientapp/dist into the plugin folder..." Importance="high" />
    <ItemGroup>
      <ATDistFiles Include="$(MSBuildThisFileDirectory)clientapp\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ATDistFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
