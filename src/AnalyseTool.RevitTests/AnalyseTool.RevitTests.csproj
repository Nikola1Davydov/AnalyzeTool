<Project Sdk="Nice3point.Revit.Sdk/6.2.3">

  <!--
    The IN-REVIT test project — tier 3 of the test strategy (CLAUDE.md, "Testing").

    Scaffolded from `dotnet new revit-tunit` (Nice3point.Revit.Templates): Nice3point.TUnit.Revit
    marshals every test onto the thread of a real Revit that the test host starts, so the tests need a
    licensed Revit of the selected year. That is why this project is NOT part of the solution build
    and NOT run in CI: run it by hand on a machine with Revit.

        dotnet test ‑‑project src/AnalyseTool.RevitTests/AnalyseTool.RevitTests.csproj -c Debug.R25

    What belongs here: anything that needs a Document. Tests seed a fresh in-memory model in code
    (Level + walls in a transaction) and exercise the SERVICES the commands delegate to —
    DataElementsCollectorService, ViewsSheetsService, TypeAndWorksetService, ParameterWriteService —
    never the commands themselves: a command runs through RunInRevitAsync(app => …) on a
    UIApplication, and the test host has no UI session (no RevitAPIUI here, by the template's rule).

    Configurations are the template's (Debug.R25 …), not the plugin's ("Debug R25"): the Revit SDK
    derives the Revit year from them. The referenced plugin projects receive the same Configuration
    name and fall back through AnalyseTool.Extension.props to the year in it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <Configurations>Debug.R25;Debug.R26;Debug.R27;Release.R25;Release.R26;Release.R27</Configurations>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <!-- RevitAPI.dll is AMD64; without this MSBuild warns about MSIL vs AMD64 on every build (MSB3270). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Not AnalyseTool.Test (the old project name): a namespace whose last segment is "Test" shadows HookType.Test in [Before(Test)]. -->
    <RootNamespace>AnalyseTool.RevitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating by Revit year, as the template does; VersionOverride because central package
         management (src/Directory.Packages.props) refuses floating versions otherwise. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" VersionOverride="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.TUnit.Revit" VersionOverride="$(RevitVersion).*" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnalyseTool.Sdk\AnalyseTool.Sdk.csproj" />
    <ProjectReference Include="..\AnalyseTool.Tools\AnalyseTool.Tools.csproj" />
  </ItemGroup>

</Project>
