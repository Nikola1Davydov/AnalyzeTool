<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately Revit-free and outside src/: this is the spike that proves we can write .frag
    without an IFC round-trip. It targets plain net8.0 so it builds and tests on any machine (no
    Revit API, no Windows). When the format work is settled, the library moves into
    src/AnalyseTool.Tools/Geometry/Infrastructure/ and inherits Tools' TFMs; the Revit-facing
    mapper is the only part that has to change.

    Not under src/, so neither Central Package Management nor Check-Boundaries.ps1 applies here.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnalyseTool.Fragments</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the flatc that generated Schema/*.cs (25.2.10) — the generated code calls
         FlatBufferConstants.FLATBUFFERS_25_2_10() and fails to compile against another runtime. -->
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by flatc; see tools/generate-bindings.sh. Not our code, so keep it out of analysis. -->
    <Compile Update="Schema/*.cs">
      <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    </Compile>
  </ItemGroup>

</Project>
